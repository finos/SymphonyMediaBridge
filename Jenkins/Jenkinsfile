@Library('SFE-RTC-pipeline') _

// Node + GAR npm auth. GAR access tokens are short-lived, so create a private
// user-level npm config from the active gcloud identity for each invocation.
// Registry routing remains in the committed project-level .npmrc.
def withNodeGar(String nodeVersion, Closure body) {
    nvm(nodeVersion) {
        def npmrc = "${env.WORKSPACE}/.npmrc.ci"
        withEnv([
                "NPM_CONFIG_USERCONFIG=${npmrc}",
                "NPM_CONFIG_CACHE_MIN=9999999",
                "NPM_CONFIG_NO_PROGRESS=1",
                "NPM_CONFIG_NETWORK_TIMEOUT=9999999"]) {
            // The explicit shebang avoids Jenkins' `sh -xe`, which would expose
            // the token assignment in the build log.
            sh(label: "Write GAR npm credentials", script: """#!/bin/bash
set -e
umask 077
TOKEN=\$(gcloud auth print-access-token)
cat > ${npmrc} <<EOF
//us-east4-npm.pkg.dev/sym-prod-mr-tools-01/sym-npmjs-virtual/:_authToken=\${TOKEN}
//us-east4-npm.pkg.dev/sym-prod-mr-tools-01/c9-npm-us-east4/:_authToken=\${TOKEN}
EOF
""")
            body()
        }
    }
}

def withPublishGar(String repository, Closure body) {
    def project = "sym-prod-mr-tools-01"
    def location = "us-east4"

    withCredentials([
        [$class: "FileBinding",
         credentialsId: "sym-rtc-dev-jenkins-deploy-creds",
         variable: "GOOGLE_APPLICATION_CREDENTIALS"]
    ]) {
        sh(label: "Authenticate to GAR", script: '''#!/bin/bash
set -e
gcloud auth activate-service-account \
    --key-file="$GOOGLE_APPLICATION_CREDENTIALS"
''')

        def publish = { Map artifact ->
            if (!artifact.package || !artifact.version || !artifact.source) {
                error("GAR publication requires package, version, and source")
            }

            if (!fileExists(artifact.source as String)) {
                error("GAR source does not exist: ${artifact.source}")
            }

            withEnv([
                "GAR_PROJECT=${project}",
                "GAR_LOCATION=${location}",
                "GAR_REPOSITORY=${repository}",
                "GAR_PACKAGE=${artifact.package}",
                "GAR_VERSION=${artifact.version}",
                "GAR_SOURCE=${artifact.source}"
            ]) {
                sh(label: "Publish ${artifact.package} ${artifact.version} to GAR",
                   script: '''#!/bin/bash
set -e
gcloud artifacts generic upload \
    --quiet \
    --project="$GAR_PROJECT" \
    --location="$GAR_LOCATION" \
    --repository="$GAR_REPOSITORY" \
    --package="$GAR_PACKAGE" \
    --version="$GAR_VERSION" \
    --source="$GAR_SOURCE"
''')
            }
        }

        body(publish)
    }
}

properties([
    buildDiscarder(logRotator(artifactNumToKeepStr: "15", numToKeepStr: "15"))
])

node('be-integration') {
    def baseName = "rtc-smb"
    def devVersion = "0.0.2"
    def masterVersion = "2.4.0"
    def scmVars
    def isReleaseBuild = false
    def version
    try {
        cleanWs()

        env.GIT_COMMITTER_NAME = "Jenkins deployment job"
        env.GIT_COMMITTER_EMAIL = "jenkinsauto@symphony.com"

        stage('Checkout') {
            scmVars = checkout scm
            env.GIT_COMMIT = scmVars.GIT_COMMIT
            env.GIT_BRANCH = scmVars.GIT_BRANCH

            def versionPrefix = devVersion
            if (env.GIT_BRANCH.equals("master")) {
                versionPrefix = masterVersion
                isReleaseBuild = true
            } else if (env.GIT_BRANCH ==~ /\d+\.\d+\.\d+/) {
                versionPrefix = env.GIT_BRANCH
                isReleaseBuild = !env.GIT_BRANCH.startsWith("0")
            }

            // The short commit sha is appended as a separate, dot-delimited semver pre-release
            // identifier (2.4.0-619.g1a2b3c4) so that the version alone identifies the exact source
            // state it was built from: https://github.com/finos/SymphonyMediaBridge/tree/<short sha>
            // Keeping the build number as its own numeric identifier preserves numeric ordering in
            // both semver and dpkg comparisons, which "2.4.0-619-g1a2b3c4" would have degraded to a
            // string compare that breaks when the build number gains a digit.
            version = "${versionPrefix}-${currentBuild.number}.g${scmVars.GIT_COMMIT.take(7)}"

            // Set the version env variable so that it's picked up by versioninfo.sh run as part of the build
            env.VERSION=version

            currentBuild.displayName = "#${currentBuild.number} ${version}"
        }

        sh "gcloud auth configure-docker europe-west1-docker.pkg.dev --quiet"

        docker.image('europe-west1-docker.pkg.dev/sym-dev-rtc/rtc-jenkins-tools/buildsmb-el8:latest').inside {
            stage('Build RHEL 8') {
                sh "docker/el8/buildscript.sh Release"
            }

            stage('Run tests RHEL 8') {
                sh "docker/el8/runtests.sh"
            }
        }

        docker.image('europe-west1-docker.pkg.dev/sym-dev-rtc/rtc-jenkins-tools/buildsmb-ubuntu-jammy:latest').inside {
            stage('Build Ubuntu Jammy') {
                sh "docker/ubuntu-jammy/buildscript.sh Release"
            }

            stage('Run tests Ubuntu Jammy') {
                sh "docker/ubuntu-jammy/runtests.sh"
            }
        }

        docker.image('europe-west1-docker.pkg.dev/sym-dev-rtc/rtc-jenkins-tools/buildsmb-ubuntu-focal-deb:latest').inside {
            stage('Build Ubuntu Focal deb release') {
                sh "docker/ubuntu-focal-deb/buildscript.sh Release $version"
            }

            stage('Run tests Ubuntu Focal deb release') {
                sh "docker/ubuntu-focal-deb/runtests.sh"
            }
        }

        docker.image('europe-west1-docker.pkg.dev/sym-dev-rtc/rtc-jenkins-tools/buildsmb-aws-linux:latest').inside {
            stage('Build AWS linux2 release') {
                sh "docker/aws-linux/buildscript.sh Release $version"
            }

            stage('Run tests AWS linux2 release') {
                sh "docker/aws-linux/runtests.sh"
            }
        }

        docker.image('europe-west1-docker.pkg.dev/sym-dev-rtc/rtc-jenkins-tools/buildsmb-ubuntu-focal-deb:latest').inside {
            stage('Create archive') {
                sh "zip -r ${baseName}-${version}.zip el8/smb/smb el8/smb/versioninfo.txt el8/smb/libs/ ubuntu-jammy/smb/smb ubuntu-jammy/smb/versioninfo.txt ubuntu-jammy/smb/libs/ ubuntu-focal-deb/smb/*.tar.gz ubuntu-focal-deb/smb/*.deb aws-linux/smb/versioninfo.txt aws-linux/smb/libs/ aws-linux/smb/smb"
            }
        }

        stage ("npm publish") {
            sh "mkdir npm-publish"
            dir("npm-publish") {
                sh "cp ../.npmrc ."
                sh "cp -R ../aws-linux/smb/libs ."
                sh "cp ../aws-linux/smb/smb ."
                sh "cp ../aws-linux/smb/versioninfo.txt ."
                writeJSON(file: 'package.json', json: [
                    name: "@symphony/smb-linux",
                    version: version,
                    description: "Symphony media bridge binaries for linux",
                    publishConfig: [
                        registry: "https://us-east4-npm.pkg.dev/sym-prod-mr-tools-01/c9-npm-us-east4/"
                    ]
                ])
                withNodeGar("v16.16.0") {
                    sh "npm publish --access public"
                }
            }
        }

        stage('Publish Artifactory [rtc-local-dev]') {
            withPublishGar('c9-generic-us-east4') { publish ->
                publish(
                    package: baseName,
                    version: version,
                    source: "${baseName}-${version}.zip"
                )
            }
        }

        if (isReleaseBuild) {
            stage('Publish Artifactory [services]') {
                echo "${baseName} ${version} was published to the immutable GAR repository in the preceding publication stage"
            }
        }

        // No git tag is published: origin here is the finos/SymphonyMediaBridge repo, which we cannot
        // push tags to. The version pinned below identifies the source state on its own, since it
        // carries the short commit sha it was built from.
        if (env.GIT_BRANCH.equals("master")) {
            withGitCredentials('github-app-symphony') {
                dir ("rtc-media-bridge") {
                    git url: "https://github.com/SymphonyOSF/rtc-media-bridge/", credentialsId: "github-app-symphony", branch: "master"
                    def versionFilePath = "tools/scripts/get-smb-deps.sh"
                    sh "sed -i 's|^SMB_VERSION=.*\$|SMB_VERSION=${version}|g' ${versionFilePath}"
                    // Fail loudly rather than pushing a stale pin if the sed silently matched nothing
                    sh "grep -qxF 'SMB_VERSION=${version}' ${versionFilePath}"
                    sh "git add ${versionFilePath}"
                    sh "git commit -m \"Automatic update of smb to '${version}'\" -m \"SMB source: https://github.com/finos/SymphonyMediaBridge/commit/${scmVars.GIT_COMMIT}\" -m \"Jenkins build: ${BUILD_URL}\""
                    sh "git push origin HEAD:master"
                }
            }
        }

    } finally {
        stage('Cleanup') {
            cleanWs()
        }
    }
}
